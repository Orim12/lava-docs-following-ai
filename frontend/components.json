{
	"$schema": "https://shadcn-svelte.com/schema.json",
	"style": "default",
	"tailwind": {
		"config": "tailwind.config.ts",
		"css": "src/routes/layout.css",
		"baseColor": "zinc",
		"cssVariables": true
	},
	"aliases": {
		"lib": "$lib",
		"components": "$lib/components",
		"ui": "$lib/components/ui",
		"utils": "$lib/utils",
		"hooks": "$lib/hooks"
	},
	"componentPath": "lib/components"
}
