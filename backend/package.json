{
  "name": "backend",
  "version": "1.0.0",
  "description": "Payload CMS backend",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation\" payload build",
    "dev": "concurrently -n \"CMS,DB\" -c \"bgBlue.bold,bgMagenta.bold\" \"pnpm:dev:payload\" \"pnpm:dev:db\"",
    "dev:payload": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 4000",
    "dev:db": "node ./bin/memDB.js",
    "devsafe": "rm -rf .next && pnpm dev:payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "check": "pnpm run lint && tsc",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.40.0",
    "@payloadcms/next": "3.40.0",
    "@payloadcms/richtext-lexical": "3.40.0",
    "@payloadcms/ui": "3.40.0",
    "cross-env": "^7.0.3",
    "next": "^15.3.2",
    "payload": "3.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "mongodb-memory-server": "^10.4.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0"
  }
}