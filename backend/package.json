{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -n \"CMS,DB\" -c \"bgBlue.bold,bgMagenta.bold\" \"pnpm:dev:payload\" \"pnpm:dev:db\"",
		"dev:payload": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 4000",
		"dev:db": "node ./bin/memDB.js",
		"devsafe": "rm -rf .next && pnpm dev:payload",
		"build": "next build",
		"start": "next start",
		"generate:types": "payload generate:types",
		"generate:importmap": "payload generate:importmap",
		"check": "pnpm run lint && tsc",
		"lint": "cross-env NODE_OPTIONS=--no-deprecation next lint && tsc"
	},
	"dependencies": {
		"@payloadcms/db-mongodb": "3.85.1",
		"@payloadcms/next": "3.85.1",
		"@payloadcms/plugin-cloud-storage": "3.85.1",
		"@payloadcms/plugin-seo": "3.85.1",
		"@payloadcms/richtext-lexical": "3.85.1",
		"next": "15.2.9",
		"payload": "3.85.1",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"sharp": "^0.35.1"
	},
	"devDependencies": {
		"@types/react": "19.2.1",
		"@types/react-dom": "19.2.1",
		"concurrently": "9.2.1",
		"cross-env": "7.0.3",
		"eslint": "^9.39.4",
		"eslint-config-next": "^16.2.9",
		"mongodb-memory-server": "11.2.0",
		"typescript": "5.6.3"
	}
}
